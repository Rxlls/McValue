# 复制本文件为 .env 后填入真实值。.env 已在 .gitignore 中，绝不入库。

# 麦当劳官方 MCP Server 地址
MCD_MCP_URL=https://mcp.mcd.cn

# 麦当劳 MCP Token（open.mcd.cn 控制台激活后获取）。留空则自动降级为模拟数据模式。
MCD_MCP_TOKEN=

# live = 真实调用官方 MCP；mock = 仅使用模拟数据；auto = 有 token 走 live，否则 mock
MCD_MCP_MODE=auto

# 真实下单总开关。默认 false，任何情况下都不会调用 create-order。
ENABLE_MCD_REAL_ORDER=false

# Web 服务端口
PORT=5173
